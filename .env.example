# ===========================================
# 주식 분석 플랫폼 환경 설정
# 이 파일을 .env로 복사한 후 필요에 따라 값을 수정하세요.
# cp .env.example .env
# ===========================================

# --- 서버 설정 ---
# 백엔드 API 서버 호스트 (0.0.0.0: 모든 인터페이스에서 접근 허용)
API_HOST=0.0.0.0

# 백엔드 API 서버 포트
API_PORT=8000

# 프론트엔드 개발 서버 포트
FRONTEND_PORT=5173

# --- 데이터 설정 ---
# 데이터 파일 경로 (섹터, 지표 정의 JSON 파일 위치)
DATA_DIR=./data

# --- 뉴스 설정 ---
# 뉴스 자동 새로고침 간격 (초)
NEWS_REFRESH_INTERVAL=60

# 네이버 뉴스 크롤링 활성화 여부 (true/false)
NAVER_NEWS_ENABLED=true
